FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN pip install uv && uv sync --no-dev --no-install-project

COPY src/ ./src/
COPY models/ ./models/

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uv", "run", "--no-sync", "uvicorn", "medical_imaging_ai.api.main:app", "--host", "0.0.0.0", "--port", "8000"]